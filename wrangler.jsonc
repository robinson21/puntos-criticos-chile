{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puntos-criticos",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/data/*", "/api/*", "/health"]
  },
  // Tiles OpenWeatherMap y NASA FIRMS: los sirve el Worker owm-proxy (ver wrangler.owm-proxy.toml)
  "services": [{ "binding": "OWM_PROXY", "service": "owm-proxy" }]
}
